{
  "testEnvironment": "node",
  "collectCoverageFrom": [
    "src/**/*.js",
    "!src/**/*.test.js",
    "!src/app.js"
  ],
  "coverageDirectory": "coverage",
  "testMatch": [
    "**/tests/**/*.test.js"
  ],
  "transform": {},
  "testTimeout": 10000,
  "setupFilesAfterEnv": [
    "<rootDir>/tests/setup.js"
  ]
}
